#include <iostream>
#include <cmath>
using namespace std;

/**
 *@param x - значение переменной x
 *@param y - значение переменной y
 *@param z - значение переменной z
 *@return - возращает вычесленное значение
 */
double geta(const double x, const double y, const double z );

/**
 *@param x - значение переменной x
 *@param y - значение переменной y
 *@param z - значение переменной z
 *@return - возращает вычесленное значение
 */

 double getb(const double x, const double y, const double z);
/**
 *@return - возращает 0 если программа выполнена корректно
 */
int main()

{
    const double x = 2.2;
    const double y = 9.2;
    const double z = 10.2;
    cout<<"a = "<<geta(x,y,z)<<endl;
    cout<<"b = "<<getb(x,y,z);
    return 0;
}

double geta(const double x, const double y, const double z )
{
    return log(z+pow(x,2))+pow(sin(x/y),2);
}

double getb(const double x, const double y, const double z)
{
    return exp(-z)*(x*sqrt(x+z)/(x-sqrt(fabs(z-y))));
}
