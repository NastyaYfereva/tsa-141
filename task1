 double getb(const double x, const double y, const double z);
/**
 *@return - âîçâðàùàåò 0, åñëè ïðîãðàììà âûïîëíåíà êîððåêòíî
 */
int main()

{
    const double x = 2.2;
    const double y = 9.2;
    const double z = 10.2;
    cout<<"a = "<<geta(x,y,z)<<endl;
    cout<<"b = "<<getb(x,y,z);
